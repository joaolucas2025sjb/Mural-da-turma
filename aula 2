<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>

  <title>DarkConnect</title>

  <!-- Tailwind -->
  <script src="https://cdn.tailwindcss.com"></script>

  <style>
    body{
      background:#020617;
    }

    ::-webkit-scrollbar{
      width:8px;
    }

    ::-webkit-scrollbar-thumb{
      background:#1e293b;
      border-radius:20px;
    }

    .glass{
      background:rgba(15,23,42,0.75);
      backdrop-filter:blur(12px);
    }
  </style>
</head>

<body class="text-white min-h-screen">

  <!-- APP -->
  <div class="flex h-screen overflow-hidden">

    <!-- SIDEBAR -->
    <aside class="w-[320px] bg-black border-r border-slate-800 flex flex-col">

      <!-- LOGO -->
      <div class="p-6 border-b border-slate-800">

        <h1 class="text-3xl font-black text-blue-500">
          DarkConnect
        </h1>

        <p class="text-slate-400 mt-1">
          Rede social moderna
        </p>

      </div>

      <!-- PERFIL -->
      <div class="p-5 border-b border-slate-800 flex items-center gap-4">

        <div class="w-14 h-14 rounded-full bg-blue-600 flex items-center justify-center text-2xl font-bold">
          U
        </div>

        <div>
          <h2 class="font-bold text-lg">
            Usuário
          </h2>

          <p class="text-slate-400 text-sm">
            Online
          </p>
        </div>

      </div>

      <!-- CONTATOS -->
      <div class="flex-1 overflow-y-auto">

        <!-- CONTATO -->
        <button
          onclick="openChat('Lucas')"
          class="w-full p-4 border-b border-slate-800 hover:bg-slate-900 transition flex items-center gap-4"
        >

          <div class="w-12 h-12 rounded-full bg-blue-500 flex items-center justify-center font-bold">
            L
          </div>

          <div class="text-left">
            <h3 class="font-semibold">
              Lucas
            </h3>

            <p class="text-sm text-slate-400">
              Bora jogar hoje?
            </p>
          </div>

        </button>

        <button
          onclick="openChat('Amanda')"
          class="w-full p-4 border-b border-slate-800 hover:bg-slate-900 transition flex items-center gap-4"
        >

          <div class="w-12 h-12 rounded-full bg-blue-500 flex items-center justify-center font-bold">
            A
          </div>

          <div class="text-left">
            <h3 class="font-semibold">
              Amanda
            </h3>

            <p class="text-sm text-slate-400">
              Te mandei as fotos
            </p>
          </div>

        </button>

        <button
          onclick="openChat('Carlos')"
          class="w-full p-4 border-b border-slate-800 hover:bg-slate-900 transition flex items-center gap-4"
        >

          <div class="w-12 h-12 rounded-full bg-blue-500 flex items-center justify-center font-bold">
            C
          </div>

          <div class="text-left">
            <h3 class="font-semibold">
              Carlos
            </h3>

            <p class="text-sm text-slate-400">
              Valeu mano
            </p>
          </div>

        </button>

      </div>

    </aside>

    <!-- CHAT -->
    <main class="flex-1 flex flex-col bg-slate-950">

      <!-- TOP -->
      <header class="h-20 border-b border-slate-800 px-8 flex items-center justify-between glass">

        <div class="flex items-center gap-4">

          <div class="w-12 h-12 rounded-full bg-blue-600 flex items-center justify-center font-bold">
            <span id="chatInitial">
              L
            </span>
          </div>

          <div>

            <h2
              id="chatName"
              class="font-bold text-xl"
            >
              Lucas
            </h2>

            <p class="text-green-400 text-sm">
              Online
            </p>

          </div>

        </div>

        <button class="bg-blue-600 hover:bg-blue-500 transition px-5 py-2 rounded-xl font-semibold">
          Ver Perfil
        </button>

      </header>

      <!-- MENSAGENS -->
      <section
        id="messages"
        class="flex-1 overflow-y-auto p-8 space-y-6"
      >

        <!-- RECEBIDA -->
        <div class="flex">

          <div class="bg-slate-800 max-w-[500px] px-5 py-4 rounded-2xl rounded-bl-none">
            E aí, tudo certo?
          </div>

        </div>

        <!-- ENVIADA -->
        <div class="flex justify-end">

          <div class="bg-blue-600 max-w-[500px] px-5 py-4 rounded-2xl rounded-br-none">
            Tudo sim 😄
          </div>

        </div>

      </section>

      <!-- INPUT -->
      <footer class="p-5 border-t border-slate-800 bg-black">

        <form
          id="messageForm"
          class="flex gap-4"
        >

          <input
            type="text"
            id="messageInput"
            placeholder="Digite sua mensagem..."
            class="flex-1 bg-slate-900 border border-slate-700 rounded-2xl px-5 py-4 outline-none focus:border-blue-500"
          />

          <button
            type="submit"
            class="bg-blue-600 hover:bg-blue-500 transition px-8 rounded-2xl font-bold"
          >
            Enviar
          </button>

        </form>

      </footer>

    </main>

  </div>

  <!-- SCRIPT -->
  <script>

    const form = document.getElementById("messageForm");
    const input = document.getElementById("messageInput");
    const messages = document.getElementById("messages");

    // ENVIAR MENSAGEM
    form.addEventListener("submit", (e) => {

      e.preventDefault();

      const text = input.value.trim();

      if(!text) return;

      const div = document.createElement("div");

      div.className = "flex justify-end";

      div.innerHTML = `
        <div class="bg-blue-600 max-w-[500px] px-5 py-4 rounded-2xl rounded-br-none">
          ${text}
        </div>
      `;

      messages.appendChild(div);

      messages.scrollTop = messages.scrollHeight;

      input.value = "";

      // RESPOSTA AUTOMATICA
      setTimeout(() => {

        const reply = document.createElement("div");

        reply.className = "flex";

        reply.innerHTML = `
          <div class="bg-slate-800 max-w-[500px] px-5 py-4 rounded-2xl rounded-bl-none">
            Mensagem recebida 👍
          </div>
        `;

        messages.appendChild(reply);

        messages.scrollTop = messages.scrollHeight;

      }, 1000);

    });

    // TROCAR CHAT
    function openChat(name){

      document.getElementById("chatName").innerText = name;

      document.getElementById("chatInitial").innerText =
        name.charAt(0).toUpperCase();

      messages.innerHTML = `
        <div class="flex">
          <div class="bg-slate-800 max-w-[500px] px-5 py-4 rounded-2xl rounded-bl-none">
            Conversa iniciada com ${name}
          </div>
        </div>
      `;
    }

  </script>

</body>
</html>